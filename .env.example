# Copia este archivo a .env y configura aquí los datos de tu proveedor.
# Crea un token de Workers AI y copia también el Account ID desde Cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Opcional: ruta de la base SQLite. Por defecto usa %LOCALAPPDATA%\ChatLocal\chat.sqlite3 en Windows.
# DATABASE_PATH=
